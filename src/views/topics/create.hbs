<h1>Crear nuevo tema</h1>

<form class="form-card" action="/topics" method="POST">
  <label>
    Título
    <input type="text" name="title" required>
  </label>

  <label>
    Descripción
    <textarea name="description" rows="5" required></textarea>
  </label>

  <button type="submit" class="primary-btn">Crear</button>
  <a href="/topics" class="cancel-link">Cancelar</a>
</form>
