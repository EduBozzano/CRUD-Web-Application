<h1>Temas de Aprendizaje</h1>

<a href="/topics/create">➕ Crear nuevo tema</a>

<ul id="topics-container">
  {{#each topics}}
    <li class="topic" data-id="{{this.id}}" data-updated="{{this.updatedAt}}">
      <h3>{{this.title}}</h3>
      <p>{{this.description}}</p>

      <strong>Votos: <span class="votes">{{this.votesCount}}</span></strong>

      <!-- botones de votacion -->
      <div>
        <button class="vote-btn" data-value="1">+1</button>
        <button class="vote-btn" data-value="-1">-1</button>
      </div>

      <div>
        <a href="/topics/{{this.id}}/edit">✏️ Editar</a>

        <form action="/topics/{{this.id}}/delete" method="POST" style="display:inline;">
          <button type="submit">🗑 Eliminar</button>
        </form>
      </div>
    </li>
  {{/each}}
</ul>
