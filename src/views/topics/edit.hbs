<h1>Editar tema</h1>

<form class="form-card" action="/topics/{{topic.id}}/edit" method="POST">
  <label>
    Título
    <input type="text" name="title" value="{{topic.title}}" required>
  </label>

  <label>
    Descripción
    <textarea name="description" rows="5" required>{{topic.description}}</textarea>
  </label>

  <button type="submit" class="primary-btn">Guardar cambios</button>
  <a href="/topics" class="cancel-link">Cancelar</a>
</form>
